# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ──────────────────────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fixmate?retryWrites=true&w=majority
DB_NAME=fixmate

# ── Client ────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ── BetterAuth ────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000

# ── Stripe (test mode) ────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── ImgBB ─────────────────────────────────────────────────
IMGBB_API_KEY=
